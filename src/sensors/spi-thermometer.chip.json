{
  "schema": "velxio-chip/v1",
  "name": "SPI Thermometer",
  "author": "Velxio",
  "license": "MIT",
  "description": "MAX6675-style thermocouple reader over SPI, temperature on a live slider. 16-bit word, 0.25 C per LSB.",
  "pins": ["VCC", "GND", "SCK", "MISO", "MOSI", "CS"],
  "attributes": [
    { "name": "temp_c", "label": "Temperature", "type": "float", "default": 25, "min": 0, "max": 500, "step": 0.25 }
  ],
  "controls": [
    { "id": "temp_c", "label": "Temperature", "type": "range", "min": 0, "max": 500, "step": 0.25, "unit": "C" }
  ]
}
